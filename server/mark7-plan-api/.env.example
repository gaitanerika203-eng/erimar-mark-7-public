MARK7_DIFY_ENABLED=false
# Single owner credentials; keep only in Vercel secret store:
MARK7_DIFY_API_TOKEN=REPLACE_WITH_RANDOM_TOKEN_OF_AT_LEAST_32_CHARACTERS
# For multi-installation tokens, use JSON array of {tenant, token} objects in secret manager:
# MARK7_DIFY_TOKENS_JSON=[{"tenant":"tenant-001","token":"<random-secret>"}]
MARK7_DIFY_REQUESTS_PER_MINUTE=20
# Distributed quotas required in production (separate Redis credential):
MARK7_REDIS_REST_URL=https://<upstash-host>
MARK7_REDIS_REST_TOKEN=<secret>
